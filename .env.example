# .env.example — Global Mesh Fast-Track (bogubhai-novelty)
# Copy this file to .env and fill in any credentials you have.
# Leave blank any you do not have — those connectors are marked UNAVAILABLE.
# NEVER commit .env. Never print secrets.

# Required: alert safety mode. Must be dry_run (default). Never enable live.
ALERT_MODE=dry_run

# Optional: MongoDB connection (default mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=floodwatch

# Optional: NASA Earthdata credentials (enables IMERG rain, Phase N2)
EARTHDATA_USERNAME=
EARTHDATA_TOKEN=

# Optional: Global Flood Monitor credentials (Phase N1 enhancement)
GFM_EMAIL=
GFM_PASSWORD=

# Optional: ReliefWeb app name (verification enhancement)
RELIEFWEB_APPNAME=

# Optional: ECMWF EWDS bulk GloFAS (use Open-Meteo flood API instead)
EWDS_URL=
EWDS_KEY=

# Optional: CDS / USGS bulk ERA5 / gauges (use Open-Meteo archive instead)
CDS_URL=
CDS_KEY=
USGS_API_KEY=

# Optional: Firebase Cloud Messaging (mock client by default; dry_run only)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FCM_VAPID_KEY=
