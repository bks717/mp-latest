# FloodWatch Dashboard Environment Configuration
# Copy this file to .env and fill in values as needed.

# Server
PORT=3000
HOST=0.0.0.0

# AI Engine URL
API_URL=http://127.0.0.1:8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/floodwatch
MONGODB_DB=floodwatch

# Alert mode (safety: must be dry_run for educational/development use)
ALERT_MODE=dry_run
